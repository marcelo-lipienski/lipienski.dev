---
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <!-- Subtle Background Gradients -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-sky-500/10 blur-[130px] -z-10 rounded-full pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[300px] bg-indigo-500/10 blur-[120px] -z-10 rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Solo & Niche Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900 border border-slate-700/80 text-xs font-mono text-slate-300">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Solo Consultancy • Direct Senior Engineering</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
          Modernizing legacy PHP applications <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-sky-300 to-indigo-300">without the risk of a full rewrite.</span>
        </h1>

        <p class="text-base sm:text-lg md:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          I help founders, CTOs, and engineering teams fix bugs, upgrade outdated PHP versions (5.x/7.x &rarr; 8.x), refactor monoliths, and add rock-solid automated tests.
        </p>

        <p class="text-sm sm:text-base text-slate-400 font-medium max-w-2xl mx-auto lg:mx-0">
          <strong class="text-slate-200">Zero agency fluff:</strong> When you hire me, you get 100% of my hands-on senior engineering expertise. Your codebase is never outsourced or passed down to junior staff.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-base shadow-lg shadow-sky-500/25 hover:shadow-sky-500/40 hover:-translate-y-0.5 transition-all"
          >
            <span>Book a Technical Consult</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#services"
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 text-slate-200 font-semibold text-base transition-colors"
          >
            Explore Services
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="pt-4 grid grid-cols-3 gap-4 border-t border-slate-800/80 max-w-xl mx-auto lg:mx-0 text-left">
          <div>
            <div class="text-xl sm:text-2xl font-bold font-mono text-white">PHP 8.x</div>
            <div class="text-xs text-slate-400">Safe Version Migration</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-bold font-mono text-white">0% &rarr; 90%</div>
            <div class="text-xs text-slate-400">Test Coverage Added</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-bold font-mono text-white">100%</div>
            <div class="text-xs text-slate-400">Founder Led & Executed</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Code Modernization Terminal -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl bg-slate-950/90 border border-slate-800 shadow-2xl overflow-hidden font-mono text-xs sm:text-sm">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-slate-900/90 border-b border-slate-800/80">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            </div>
            <span class="text-slate-400 text-xs">php-modernize.sh</span>
            <div class="text-slate-500 text-xs">bash</div>
          </div>

          <!-- Terminal Body -->
          <div class="p-5 space-y-3 text-slate-300 leading-relaxed overflow-x-auto">
            <div class="text-slate-400">
              <span class="text-emerald-400">marcelo@consultancy</span>:<span class="text-sky-400">~/app</span>$ php --version
            </div>
            <div class="text-rose-400">
              PHP 5.6.40 (cli) (built: Jan 10 2019) <span class="text-slate-500">// End of Life! Security risks</span>
            </div>

            <div class="pt-2 text-slate-400">
              <span class="text-emerald-400">marcelo@consultancy</span>:<span class="text-sky-400">~/app</span>$ run-audit --deep
            </div>
            <div class="space-y-1 text-slate-300 pl-2 border-l-2 border-slate-800">
              <div class="text-amber-400">⚠ 142 deprecated functions & fatal syntax incompatibilities</div>
              <div class="text-rose-400">✖ 0 automated test suites detected</div>
              <div class="text-amber-400">⚠ 8 unindexed N+1 queries causing severe latency</div>
            </div>

            <div class="pt-2 text-slate-400">
              <span class="text-emerald-400">marcelo@consultancy</span>:<span class="text-sky-400">~/app</span>$ modernize --incremental
            </div>
            <div class="space-y-1 text-emerald-400 pl-2 border-l-2 border-emerald-500/50 bg-emerald-950/20 py-1.5 rounded-r">
              <div>✔ Upgraded safely: PHP 5.6 &rarr; PHP 8.3 (JIT Enabled)</div>
              <div>✔ PHPUnit & Pest test suites configured (284 tests passed)</div>
              <div>✔ Static analysis: PHPStan Level 8 clean</div>
              <div>✔ Response time reduced by 64% (1.4s &rarr; 210ms)</div>
              <div>✔ Zero downtime deployment to production</div>
            </div>

            <div class="pt-2 text-slate-400 flex items-center gap-1.5">
              <span class="text-emerald-400">marcelo@consultancy</span>:<span class="text-sky-400">~/app</span>$
              <span class="w-2 h-4 bg-sky-400 inline-block animate-pulse"></span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
