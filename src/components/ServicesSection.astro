---
const services = [
  {
    tag: 'Core Specialization',
    title: 'Legacy PHP Version Upgrades',
    description:
      'Seamlessly upgrade end-of-life PHP (5.4/5.6/7.x) to PHP 8.2, 8.3, or 8.4. Fix breaking syntax changes, incompatible extensions, and deprecated libraries without breaking existing features.',
    deliverables: [
      'Zero-downtime production deployment',
      'Removal of deprecated APIs and fatal type errors',
      'Modern PHP runtime benefits (JIT, typed properties, speed gains)',
    ],
  },
  {
    tag: 'Stability & Confidence',
    title: 'Automated Testing & Static Analysis',
    description:
      'Turn an untestable legacy monolith into a confident codebase by engineering safety nets. I implement automated test harnesses and static analysis to catch regressions before clients do.',
    deliverables: [
      'PHPUnit & Pest test suites for critical business workflows',
      'PHPStan / Psalm integrated at strict rule levels',
      'CI/CD automated regression testing on every pull request',
    ],
  },
  {
    tag: 'Architecture & Maintainability',
    title: 'Code Refactoring & Tech Debt Elimination',
    description:
      'Transform fragile spaghetti code and mammoth God classes into clean, maintainable, and modular domain code. Modernize patterns iteratively without stopping active feature delivery.',
    deliverables: [
      'Decoupling tightly bound business logic from framework layers',
      'Elimination of global state, raw SQL injections, and antipatterns',
      'Clear interfaces and strict TypeScript-grade PHP type signatures',
    ],
  },
  {
    tag: 'Scale & Efficiency',
    title: 'Performance & Database Query Optimization',
    description:
      'Eliminate severe server bottlenecks, slow response times, and runaway cloud bills. Pinpoint memory leaks and latency using deep profiling tools.',
    deliverables: [
      'Bottleneck profiling with Blackfire, Xdebug, and APM tools',
      'SQL query optimization, index tuning, and N+1 query eradication',
      'Efficient Redis caching & background queue worker architecture',
    ],
  },
  {
    tag: 'Modern Frameworks',
    title: 'Framework Migrations & Decoupling',
    description:
      'Migrate from obsolete custom in-house engines, Zend Framework 1/2, or legacy CodeIgniter into modern Laravel or Symfony using proven strangler fig patterns.',
    deliverables: [
      'Gradual strangler fig proxy architecture',
      'Shared session and database authentication layers',
      'Safe step-by-step route and controller migration',
    ],
  },
  {
    tag: 'Advisory & Team Velocity',
    title: 'Deep Codebase Audits & Architecture Reviews',
    description:
      'Get an uncompromising, senior engineering assessment of your legacy codebase. Uncover security vulnerabilities, structural bottlenecks, and receive an actionable modernization roadmap.',
    deliverables: [
      'Comprehensive vulnerability & technical debt audit report',
      'Prioritized, ROI-driven remediation action plan',
      'Guidance and pairing with your internal engineering team',
    ],
  },
];
---

<section id="services" class="py-24 bg-slate-950/70 border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-sky-400">
        Hands-On Engineering Services
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        How I help you reclaim control of your PHP codebase
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        Every project is executed directly by me with senior-level attention to detail, pragmatic engineering, and minimal disruption to your daily operations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="flex flex-col justify-between p-8 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-sky-500/40 hover:bg-slate-900/90 transition-all group">
          <div>
            <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-mono font-medium text-sky-400 bg-sky-950/60 border border-sky-800/40 mb-4">
              {service.tag}
            </span>
            <h3 class="text-xl font-bold text-white tracking-tight group-hover:text-sky-300 transition-colors">
              {service.title}
            </h3>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">
              {service.description}
            </p>

            <div class="mt-6 pt-6 border-t border-slate-800/70">
              <span class="text-xs font-mono font-semibold text-slate-400 uppercase tracking-wider block mb-3">
                Key Deliverables:
              </span>
              <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
                {service.deliverables.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-sky-400 font-bold mt-0.5">&bull;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-8 pt-4">
            <a
              href="#contact"
              class="inline-flex items-center text-xs font-mono font-semibold text-sky-400 hover:text-sky-300 gap-1"
            >
              <span>Discuss this service</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
