---
---

<section id="contact" class="py-24 bg-[#090D16] border-t border-slate-800/80 relative overflow-hidden">
  <!-- Background Glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-sky-500/10 blur-[140px] -z-10 rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 p-8 sm:p-12 lg:p-16 shadow-2xl relative">
      
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-800/80 border border-slate-700 text-xs font-mono text-sky-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Currently Accepting New Projects</span>
        </span>

        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Let's discuss modernizing your PHP codebase
        </h2>

        <p class="text-base sm:text-lg text-slate-300">
          Whether you need an immediate PHP version upgrade, an automated test harness, or an architecture audit, send me a note. You will speak directly with me.
        </p>
      </div>

      <!-- Contact Actions -->
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">
        
        <!-- Direct Email Card -->
        <a
          href="mailto:marcelo@lipienski.dev?subject=PHP%20Modernization%20Inquiry"
          class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-sky-500/50 hover:bg-slate-800/60 transition-all text-center sm:text-left flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Direct Email</div>
            <div class="text-base font-bold text-white mt-1 group-hover:text-sky-300 transition-colors">
              marcelo@lipienski.dev
            </div>
            <p class="text-xs text-slate-400 mt-2">
              Share details about your stack, timeline, or current challenges.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-xs font-semibold text-sky-400 flex items-center gap-1">
            <span>Send an Email</span>
            <span>&rarr;</span>
          </div>
        </a>

        <!-- Schedule Consult Card -->
        <a
          href="mailto:marcelo@lipienski.dev?subject=Schedule%2030-Min%20Technical%20Consult"
          class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-sky-500/50 hover:bg-slate-800/60 transition-all text-center sm:text-left flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Initial Conversation</div>
            <div class="text-base font-bold text-white mt-1 group-hover:text-sky-300 transition-colors">
              30-Min Technical Consult
            </div>
            <p class="text-xs text-slate-400 mt-2">
              A high-level technical discussion about your codebase and goals.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-xs font-semibold text-sky-400 flex items-center gap-1">
            <span>Request Consult</span>
            <span>&rarr;</span>
          </div>
        </a>

      </div>

      <!-- Trust Note -->
      <div class="mt-8 text-center text-xs text-slate-400">
        🔒 NDA signed upon request prior to codebase reviews. Response within 24 hours.
      </div>

    </div>
  </div>
</section>
